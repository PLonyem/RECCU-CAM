# Copy this file to .env.local and fill in your key.
# Get an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for the admin "Upload Chapter Profiles" file upload (Supabase
# Storage). Find these in the Supabase dashboard: Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is a secret — never expose it to the client.
# Without these set, file upload returns a clear error; manual entry still
# works with no Supabase Storage dependency.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — defaults to "chapter-profile-uploads" if unset.
SUPABASE_STORAGE_BUCKET=

# Same Supabase project, but a separate bucket for the Homepage Editor's
# hero images — must be marked *public* in the Supabase dashboard (unlike
# SUPABASE_STORAGE_BUCKET above, which is private). Optional — defaults to
# "homepage-hero-images" if unset.
SUPABASE_HERO_IMAGES_BUCKET=
