# Public application URL used for canonical metadata and email links.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL. DATABASE_URL is the pooled runtime connection; DIRECT_URL is
# the direct connection used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Clerk authentication. Create keys in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Transactional email. All values are optional in local development; when
# RESEND_API_KEY is absent the application logs a mock delivery event.
RESEND_API_KEY=
RESEND_FROM=
RESEND_ADMIN_EMAIL=

# Supabase Storage for private affiliate documents and public homepage media.
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=affiliate-document-uploads
SUPABASE_HERO_IMAGES_BUCKET=homepage-hero-images
